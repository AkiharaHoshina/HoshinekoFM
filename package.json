{
  "name": "hoshineko-fm",
  "private": true,
  "version": "0.11.30",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "e2e": "npm run build && for f in scripts/e2e/*.test.cjs; do npx electron \"$f\" || exit 1; done",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:5173 && tsc -p electron/tsconfig.json && node scripts/set-cjs.cjs && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && node scripts/set-cjs.cjs && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-rounded": "^5.2.45",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/roboto": "^5.2.10",
    "@lit-labs/react": "^2.1.3",
    "@lit/react": "^1.0.8",
    "@material/material-color-utilities": "^0.4.0",
    "@material/web": "^2.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dbus-next": "^0.10.2",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "node-pty": "1.2.0-beta.14",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-toastify": "^11.1.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^43.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "usocket": "1.1.0",
    "tar": "^7.5.22",
    "xml2js": "^0.6.2"
  },
  "build": {
    "appId": "com.hoshineko.fm",
    "productName": "HoshinekoFM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "packaging/**/*",
      "scripts/system-integration/**/*"
    ],
    "asarUnpack": [
      "packaging/**/*",
      "scripts/system-integration/**/*"
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    }
  }
}
